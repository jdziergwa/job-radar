# Required — one LLM Provider key (Anthropic or Google Gemini)
# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Gemini: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-gemini-key

# Optional — pick the LLM Provider: anthropic | gemini
# If unset, it is auto-detected when exactly one key is set; with both keys set you must choose.
# LLM_PROVIDER=anthropic

# Optional — override the Model per AI Task (must belong to the active LLM Provider)
# Precedence: profile scoring.model > Settings page > these variables > built-in default
# SCORING_MODEL=claude-haiku-5-5
# WIZARD_MODEL=claude-sonnet-5-5
# STATS_MODEL=claude-haiku-5-5

# Optional — debug log file (LLM calls, scoring). Defaults to logs/job-radar.log in the project;
# set a path to move it, or set it empty to turn the file off. Responses are logged as short excerpts.
# JOB_RADAR_LOG_FILE=logs/job-radar.log

# Optional — Linux Docker bind-mount ownership
# HOST_UID=1000
# HOST_GID=1000

# Optional — Telegram notifications
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=123456789

# Optional — Adzuna provider
# ADZUNA_APP_ID=your-adzuna-app-id
# ADZUNA_APP_KEY=your-adzuna-app-key
